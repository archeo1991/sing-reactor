limit_req_zone $binary_remote_addr zone=sing_reactor_identify:10m rate=6r/m;
limit_req_zone $binary_remote_addr zone=sing_reactor_media:10m rate=60r/m;
limit_conn_zone $binary_remote_addr zone=sing_reactor_connections:10m;

server {
    listen 80;
    listen [::]:80;
    server_name singreactor.archeo.cn;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name singreactor.archeo.cn;

    root /var/www/singreactor.archeo.cn;
    index index.html;
    client_max_body_size 2m;

    ssl_certificate /etc/letsencrypt/live/singreactor.archeo.cn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/singreactor.archeo.cn/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location = /health {
        proxy_pass http://127.0.0.1:8765;
        include proxy_params;
    }

    location = /auth/session {
        proxy_pass http://127.0.0.1:8765;
        include proxy_params;
    }

    location = /transcribe {
        proxy_pass http://127.0.0.1:8765;
        include proxy_params;
        proxy_read_timeout 360s;
        proxy_send_timeout 360s;
    }

    location /transcribe/jobs {
        proxy_pass http://127.0.0.1:8765;
        include proxy_params;
        proxy_read_timeout 360s;
        proxy_send_timeout 360s;
    }

    location = /api/identify {
        limit_req zone=sing_reactor_identify burst=2 nodelay;
        limit_conn sing_reactor_connections 3;
        proxy_pass http://127.0.0.1:18768;
        include proxy_params;
        proxy_read_timeout 900s;
        proxy_send_timeout 900s;
    }

    location = /api/align-lyrics {
        limit_req zone=sing_reactor_identify burst=2 nodelay;
        limit_conn sing_reactor_connections 3;
        proxy_pass http://127.0.0.1:18768;
        include proxy_params;
        proxy_read_timeout 900s;
        proxy_send_timeout 900s;
    }

    location = /api/video {
        limit_req zone=sing_reactor_media burst=20 nodelay;
        limit_conn sing_reactor_connections 4;
        proxy_pass http://127.0.0.1:18768;
        include proxy_params;
        proxy_set_header Range $http_range;
        proxy_set_header If-Range $http_if_range;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 900s;
    }

    location = /api/health {
        proxy_pass http://127.0.0.1:18768;
        include proxy_params;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(?:js|css|png|jpg|jpeg|gif|svg|ico|webp|woff2?)$ {
        expires 1h;
        add_header Cache-Control "public, max-age=3600";
        try_files $uri =404;
    }

    location ~* \.zip$ {
        add_header Cache-Control "no-cache";
        add_header Content-Disposition "attachment";
        try_files $uri =404;
    }
}
